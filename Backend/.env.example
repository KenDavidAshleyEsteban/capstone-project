MONGODB_URI=mongodb://127.0.0.1:27017/gunpla_db
JWT_SECRET=replace-with-a-long-random-secret
# Optional dedicated receipt-signing secret. Defaults to JWT_SECRET when omitted.
# RECEIPT_QR_SECRET=replace-with-a-separate-long-random-secret
PORT=5000
NODE_ENV=development
BACKEND_URL=http://127.0.0.1:5000
FRONTEND_URL=http://127.0.0.1:5000
# Local development saves verification messages privately; no email is sent.
EMAIL_MODE=file
# Optional outbox path relative to Backend. Default: ../.tmp/email-outbox
EMAIL_OUTBOX_DIR=../.tmp/email-outbox
# For real delivery, use EMAIL_MODE=resend and set BOTH of these values.
# Production also requires NODE_ENV=production and HTTPS base URLs above.
# RESEND_API_KEY=re_your_private_key
# EMAIL_FROM=Gunpla Hub <verification@your-verified-domain.example>
# Optional: used only by npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=StoreAdmin
ADMIN_PASSWORD=replace-with-a-strong-password
